.DS_Store
.env
.env.*
!.env.example
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
.obsidian/
.playwright-cli/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
!uv.lock

# Rebuildable local state and indexes
.raytsystem/
.qmd/

# Untrusted intake and restricted exact bytes are never Git-tracked.
inbox/*
!inbox/.gitkeep
_raw/blobs/
_raw/restricted/

# Run-local transaction material; manifests and reports are selectively force-added.
ops/locks/
ops/staging/
ops/control.sqlite
ops/control.sqlite-shm
ops/control.sqlite-wal
ops/platform.sqlite
ops/platform.sqlite-shm
ops/platform.sqlite-wal
ops/approvals/incoming/
ops/backups/
ops/encrypted/

# Draft/outbox content may contain unpublished material.
artifacts/drafts/
artifacts/outbox/

# Local raytsystem operational state and frontend build caches.
ops/task-ledger/
ops/document-revisions/
ops/runs/
web/node_modules/
web/coverage/
web/.vite/
web/.vitest-attachments/
web/src/test/__screenshots__/layout.browser.test.tsx/
web/src/test/__screenshots__/githubScreenshots.browser.test.tsx/
website/.docusaurus/
website/build/

# Personal operational material excluded from the public release.
# These stay on the author's machine but must never ship in the open-source tree.
CHATGPT_WORK_PROMPT.md
ops/donors/

# --- Windows-native workflow additions (feature/windows) ---

# Windows Explorer / shell cruft.
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Office / editor lock temp files that sneak into working trees.
~$*
.~lock.*#

# IDE / editor local state. Project-shared settings go in committed files.
.vscode/
.idea/
*.swp
*.swo
*~

# Local config overrides. Committed config/* stays tracked; *.local.* is private.
config/*.local.yaml
config/*.local.toml
.env.local
.env.*.local

# Personal planning / scratch notes for this Windows port. Keep them on the
# workstation, never in the public tree. WINDOWS.md is documentation and stays tracked.
PLAN.md
NOTES.md
WORKLOG.md
TODO.local.md
SCRATCH.md
TROUBLESHOOTING.md
TODO.md
AGENTS.md
USER_INSTRUCTIONS.md
ROADMAP.md
WORK.md
ponytail-tuning.md

# opencode agent local runtime state (history, cache, session logs).
# .opencode/skills/ is the deliverable and stays tracked.
.opencode/state/
.opencode/cache/
.opencode/logs/
.opencode/history/
.opencode/session/
.opencode/*.log
.opencode/.session*


# Root conftest.py is a local Windows override (forces pytest basetemp to
# D:\TEMP); never ship it in the public tree.
/conftest.py

# Git merge / rebase conflict artifacts (transient, never tracked).
*.orig
*.rej
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
REBASE_HEAD
MERGE_HEAD
CHERRY_PICK_HEAD
.patch.diff

